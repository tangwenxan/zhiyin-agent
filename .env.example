# ===== LLM 配置 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会被提交）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# 可选：小模型用于意图分类 / 摘要（S9 模型路由）
LLM_SMALL_MODEL=

# ===== 数据库 =====
DATABASE_URL=sqlite:///./zhiyin.db

# ===== 向量库（S2）=====
VECTOR_STORE=chroma
CHROMA_PATH=./data/chroma

# ===== 可观测（S8）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
